{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "proactive-assistant",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "traces": { "enabled": true } },
	"ai": { "binding": "AI" },
	// Same-origin UI + Assistant. `/agents/*` must hit the Worker so the SPA
	// fallback does not swallow admission. `/session` is the cookie mint.
	// `/check/*` is live-check Review dispatch, not a UI control.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/agents/*", "/session", "/check/*"]
	},
	// Every agent generates a Durable Object class named after its identity
	// (Assistant -> FlueAssistantAgent), and Cloudflare requires a migration entry
	// for each one. Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlueAssistantAgent"] }]
}
